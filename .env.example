# AI Interview Prep Kit — Environment Variable Reference
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in the real values.
# The frontend reads its own .env.local file (see the FRONTEND section below).
# NEVER commit .env or .env.local files to source control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────

MONGODB_URI=mongodb://localhost:27017/interview-prep-kit
# Full MongoDB connection string.
# Local:  mongodb://localhost:27017/interview-prep-kit
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority


# ── Authentication ────────────────────────────────────────────────────────────

JWT_SECRET=CHANGE_ME_use_a_long_random_string_at_least_32_characters
# Secret used to sign and verify JWTs (HS256 algorithm).
# Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_EXPIRY=24h
# JWT lifetime as a string parseable by the jsonwebtoken library.
# Examples: "24h", "1d", "7d". Default: 24h.


# ── LLM Provider ─────────────────────────────────────────────────────────────

LLM_PROVIDER=gemini
# Which LLM provider the extraction pipeline uses.
# Accepted values: "gemini" | "groq"
# Each provider requires its own API key variable below.

GEMINI_API_KEY=CHANGE_ME_your_google_gemini_api_key
# Google Gemini API key. Required when LLM_PROVIDER=gemini.
# Obtain from: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1 million TPM per day (as of mid-2024).

GEMINI_MODEL=gemini-1.5-flash
# Gemini model to use. Default: gemini-1.5-flash (fast, free-tier eligible).
# Alternatives: "gemini-2.0-flash", "gemini-1.5-pro" (check your account).

GROQ_API_KEY=
# Groq API key. Required only when LLM_PROVIDER=groq.
# Obtain from: https://console.groq.com
# Leave blank if using LLM_PROVIDER=gemini.

GROQ_MODEL=llama-3.1-70b-versatile
# Groq model. Used only when LLM_PROVIDER=groq.
# Default: llama-3.1-70b-versatile.


# ── Research / Search Provider ───────────────────────────────────────────────

RESEARCH_PROVIDER=duckduckgo
# Which search provider the ResearchAgent uses to find public interview discussions.
# Accepted values: "duckduckgo" | "serpapi"
# "duckduckgo" requires no API key and scrapes DuckDuckGo Instant Answers.
# "serpapi" requires the SERPAPI_KEY below and provides more reliable results.

SERPAPI_KEY=
# SerpApi API key. Required only when RESEARCH_PROVIDER=serpapi.
# Obtain from: https://serpapi.com (free tier: 100 searches/month).
# Leave blank if using RESEARCH_PROVIDER=duckduckgo.


# ── Server ────────────────────────────────────────────────────────────────────

PORT=4000
# Port the Express API server listens on.
# The frontend proxies API requests to this port in development.

NODE_ENV=development
# Runtime environment.
# Accepted values: "development" | "production" | "test"
# IMPORTANT: SSRF IP-range blocking (RFC 1918, loopback, link-local) is only
# active when NODE_ENV=production. In development all outbound URLs are allowed.


# ── CORS ─────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:3000
# Allowed CORS origin for the Express server.
# In development: http://localhost:3000
# In production: set to the deployed frontend URL (e.g. https://app.example.com)


# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND  (frontend/.env.local — not this file)
# ─────────────────────────────────────────────────────────────────────────────
# Create frontend/.env.local with the following variable:
#
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
#   Base URL for all client-side API requests.
#   In development: http://localhost:4000/api
#   In production:  set to the deployed backend URL (e.g. https://api.example.com/api)
# ═════════════════════════════════════════════════════════════════════════════
