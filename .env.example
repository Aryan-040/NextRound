# Root environment variables for the monorepo
# Copy this to .env for local development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/interview-prep

# JWT secret for authentication
JWT_SECRET=your-secret-key-change-this-in-production

# API keys for LLM services
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Frontend API URL (for local dev, points to backend:4000)
# In production on Vercel, this should be empty or "/" to use same-origin
NEXT_PUBLIC_API_URL=http://localhost:4000/api
