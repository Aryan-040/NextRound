    "dotenv": "^18.0.3",
    "express": "^4.18.2",
    "he": "^1.2.0",
    "helmet": "^7.1.0",
    "ipaddr.js": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "robots-parser": "^3.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/he": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^3.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "fast-check": "^3.15.0",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
