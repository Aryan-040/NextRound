    "test": "vitest --run",
    "type-check": "tsc --noEmit",
    "evaluate": "ts-node src/scripts/evaluate.ts"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
