{
  "name": "ai-interview-prep-kit",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=packages/shared && npm run build --workspaces --if-present",
    "build:vercel": "bash vercel-build.sh",
    "test": "npm run test --workspaces",
    "evaluate": "npm run evaluate --prefix backend --"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.x"
  }
}
